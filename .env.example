# ============================================================
# Clipper — Automated Faceless Clipping & Posting System
# Core engine: OpenShorts (mutonby/openshorts), self-hosted Docker.
# Copy to .env and fill in real values. .env is gitignored.
# No hardcoded keys anywhere — everything comes from this file and
# missing required keys must fail loudly, not fall back silently.
# ============================================================

# --- REQUIRED: Google Gemini (AI moment detection) --------------------
# Free tier is enough. Use gemini-2.5-flash-lite (NOT a Live API model).
GEMINI_API_KEY=

# --- REQUIRED for Phase 6 (publishing/scheduling): Upload-Post --------
# Key from upload-post.com. YouTube/TikTok/IG OAuth happens inside
# Upload-Post's own flow — never paste platform keys here.
# Not needed until clips pass the human review gate.
UPLOAD_POST_API_KEY=

# --- OPTIONAL (not used by the OpenShorts core) -----------------------
# YouTube Data API v3 — only for future metadata/search tooling.
YOUTUBE_API_KEY=

# --- OPTIONAL: OpenShorts server tweaks (see openshorts/.env.example) --
# AWS S3 backup keys, MAX_CONCURRENT_JOBS, and GPU overrides
# (WHISPER_MODEL / WHISPER_DEVICE / WHISPER_COMPUTE / FFMPEG_ENCODER)
# live in openshorts/.env if you ever need them.

# --- OPTIONAL: source download resolution cap --------------------------
# Caps the yt-dlp source pick at this height for EVERY job (YouTube,
# Twitch, direct URLs). Reason to set it: 1080p60 HLS (Twitch VODs) can
# wedge for 15+ min on a flaky network; the 720p rendition is far more
# reliable and finished clips still deliver 1080x1920 (the 9:16 crop is
# upscaled). Leave empty for full-quality sources (default). Per job you
# can override or opt out via the API's max_source_height field or
# viral-clip.bat -MaxSourceHeight (0 = use this deployment default).
# MAX_SOURCE_HEIGHT=720
