# ============================================================
# Clipper — Automated Faceless Clipping & Posting System
# Core engine: OpenShorts (mutonby/openshorts), self-hosted Docker.
# Copy to .env and fill in real values. .env is gitignored.
# No hardcoded keys anywhere — everything comes from this file and
# missing required keys must fail loudly, not fall back silently.
# ============================================================

# --- REQUIRED: Google Gemini (AI moment detection) --------------------
# Free tier is enough. Use gemini-2.5-flash-lite (NOT a Live API model).
GEMINI_API_KEY=

# --- REQUIRED for Phase 6 (publishing/scheduling): Upload-Post --------
# Key from upload-post.com. YouTube/TikTok/IG OAuth happens inside
# Upload-Post's own flow — never paste platform keys here.
# Not needed until clips pass the human review gate.
UPLOAD_POST_API_KEY=

# --- Phase 8b: self-hosted multi-platform uploader (uploader/) --------
# Replaces the Upload-Post free tier (10 uploads/month) with direct
# integrations. The uploader only reads keys from here; nothing is hardcoded.
# One-time setup per platform (details: README "Self-hosted uploader"):
#   uploader.bat check   -> shows exactly what each platform still needs
#
# YouTube (official Data API v3, OAuth desktop flow):
#   1. Google Cloud project -> enable "YouTube Data API v3"
#   2. OAuth client ID (Desktop app) -> save the JSON at
#      uploader/credentials/client_secrets.json (or set a path here)
#   3. uploader.bat login --platform youtube   (browser consent, once)
# YOUTUBE_CLIENT_SECRETS=uploader/credentials/client_secrets.json
YT_CATEGORY_ID=20
YT_PRIVACY_STATUS=public

# Instagram (official Meta Graph API, Reels publish; IG account must be
# Business/Creator). Long-lived token + the IG account id:
#   1. developers.facebook.com -> Create App (Business) -> add Instagram API
#   2. Graph API Explorer: token with instagram_basic +
#      instagram_content_publish + pages_show_list
#   3. Exchange for a long-lived token (curl in README), paste here with
#      the IG account id (GET /me?fields=instagram_business_account or /me/accounts)
IG_ACCESS_TOKEN=
IG_USER_ID=
# IG Graph API version and how the backend's /videos files become public:
IG_GRAPH_VERSION=v23.0
# Either a permanent public base URL that proxies http://localhost:8000, or
# (default) a free Cloudflare quick tunnel via cloudflared (auto-started):
# IG_PUBLIC_BASE_URL=
# IG_CLOUDFLARED_PATH=cloudflared

# Bilibili (bilibili-api-python, cookie credential - no official upload cap):
#   Log into bilibili.com, DevTools -> Application -> Cookies -> bilibili.com,
#   copy SESSDATA, bili_jct, buvid3 here. They expire - re-export when check fails.
BILI_SESSDATA=
BILI_JCT=
BILI_BUVID3=
BILI_DEDEUSERID=
BILI_AC_TIME_VALUE=
# Upload zone (tid) + tags. Common tids: 21 daily-life, 4 gaming/ esports,
# 253 short-video-ish vertical picks live in the Bilibili zone list.
BILI_TID=21
BILI_TAGS=
# 1 = original (self-made) work; 0 = repost (then set BILI_SOURCE to the
# original video URL to stay within Bilibili's repost rules).
BILI_ORIGINAL=1
BILI_SOURCE=

# Platforms the uploader posts to by default (order = upload order):
POST_PLATFORMS=youtube,instagram,bilibili

# --- OPTIONAL: OpenShorts server tweaks (see openshorts/.env.example) --
# AWS S3 backup keys, MAX_CONCURRENT_JOBS, and GPU overrides
# (WHISPER_MODEL / WHISPER_DEVICE / WHISPER_COMPUTE / FFMPEG_ENCODER)
# live in openshorts/.env if you ever need them.

# --- OPTIONAL: source download resolution cap --------------------------
# Caps the yt-dlp source pick at this height for EVERY job (YouTube,
# Twitch, direct URLs). Reason to set it: 1080p60 HLS (Twitch VODs) can
# wedge for 15+ min on a flaky network; the 720p rendition is far more
# reliable and finished clips still deliver 1080x1920 (the 9:16 crop is
# upscaled). Leave empty for full-quality sources (default). Per job you
# can override or opt out via the API's max_source_height field or
# viral-clip.bat -MaxSourceHeight (0 = use this deployment default).
# MAX_SOURCE_HEIGHT=720
