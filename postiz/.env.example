# Postiz container settings - copy this file to postiz/.env (gitignored) and fill in.
# docker compose reads postiz/.env automatically (postiz.bat start does too).
# After changing values: postiz.bat stop && postiz.bat start (recreate needed).

# REQUIRED - long random string that signs session JWTs. Generate one:
#   powershell -Command "-join((48..57)+(65..90)+(97..122)|Get-Random -Count 48|%{[char]$_})"
POSTIZ_JWT_SECRET=change-me-to-a-long-random-string

# Base URL of the Postiz UI (OAuth redirects are built from this).
# Leave at the default for localhost use.
#POSTIZ_MAIN_URL=http://localhost:4007

# Set to true AFTER your first admin account is registered (then postiz.bat stop/start).
POSTIZ_DISABLE_REGISTRATION=false

# ---------------------------------------------------------------------------
# Provider OAuth apps - needed so Postiz can CONNECT your channels.
# For each provider register an OAuth app at the provider's developer console
# with redirect URI:  http://localhost:4007/integrations/social/<provider>
# (providers overview: https://docs.postiz.com/self-host/providers/overview)
# ---------------------------------------------------------------------------
# YouTube (Google Cloud: enable YouTube Data API v3, OAuth client type "Web application")
POSTIZ_YOUTUBE_CLIENT_ID=
POSTIZ_YOUTUBE_CLIENT_SECRET=
# Facebook + Instagram (one Meta app covers both; app must have the products
# Facebook Login for Business + Instagram Graph API)
POSTIZ_FACEBOOK_APP_ID=
POSTIZ_FACEBOOK_APP_SECRET=
POSTIZ_INSTAGRAM_APP_ID=
POSTIZ_INSTAGRAM_APP_SECRET=
# TikTok (developers.tiktok.com: Login Kit + Content Posting API)
POSTIZ_TIKTOK_CLIENT_ID=
POSTIZ_TIKTOK_CLIENT_SECRET=
